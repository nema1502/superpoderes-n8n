      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Deja el nombre como lo entiende Tinkazo: sin caracteres invisibles,\n// sin comas, con un solo espacio entre palabras y 40 letras como mucho.\nfunction limpiar(texto) {\n  return String(texto || '')\n    .replace(/[​-‏⁠﻿]/g, '')\n    .replace(/,/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 40)\n}\nreturn { json: { nombre: limpiar($json.nombre) } }"
      }
