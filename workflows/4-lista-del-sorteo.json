    {
      "id": "c4a70004-0000-4009-8000-000000000fa9",
      "name": "Lista limpia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        260
      ],
      "parameters": {
        "jsCode": "// Arma la lista para Tinkazo: un nombre por línea, sin repetidos\n// (aunque cambien mayúsculas o tildes), sin enlaces ni correos.\nfunction limpiar(texto) {\n  return String(texto || '')\n    .replace(/[​-‏⁠﻿]/g, '')\n    .replace(/,/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim()\n    .slice(0, 40)\n}\n\nfunction clave(texto) {\n  return texto.normalize('NFKD').replace(/\\p{M}/gu, '').toLowerCase()\n}\n\nconst vistos = {}\nconst nombres = []\n\nfor (const item of $input.all()) {\n  const nombre = limpiar(item.json.nombre)\n  if (nombre.length < 2) continue\n  if (/https?:|www\\.|@/i.test(nombre)) continue\n  const k = clave(nombre)\n  if (vistos[k]) continue\n  vistos[k] = true\n  nombres.push(nombre)\n}\n\nreturn [{ json: { cantidad: nombres.length, lista: nombres.join('\\n') } }]"
      }
    },
